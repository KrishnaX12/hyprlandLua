@import "colors/neutral.rasi"

* {
    background-color: transparent;
    text-color: @foreground;
    border: 0;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 50%;
    background-color: @background;
    border: 1px;
    border-color: @outline;
    border-radius: 12px;
}

mainbox {
    padding: 18px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @background-alt;
    padding: 12px;
    border-radius: 8px;
    children: [ prompt, entry ];
    spacing: 8px;
}

listview {
    lines: 12;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: @selected;
    text-color: @foreground;
}

element-text {
    text-color: inherit;
}
